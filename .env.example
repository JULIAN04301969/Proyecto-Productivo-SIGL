# ============================================================
# Plantilla de variables de entorno — Proyecto SIGL
# ============================================================
# INSTRUCCIONES:
#   1. Copie este archivo y renómbrelo a .env
#   2. Complete los valores reales según su entorno local
#   3. NUNCA suba el archivo .env al repositorio (ya está en .gitignore)
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de Datos MySQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=su_contraseña_aqui
DB_NAME=leads_db

# ── Seguridad JWT ─────────────────────────────────────────────
# Mínimo 32 caracteres — cambiar obligatoriamente en producción
JWT_SECRET=clave_secreta_minimo_32_caracteres_cambiar_en_produccion
JWT_EXPIRES_IN=1h

# ── CORS (Origen permitido del Frontend) ──────────────────────
# URL del servidor local donde corre su frontend (ej. Live Server en VSCode)
FRONTEND_URL=http://127.0.0.1:5500